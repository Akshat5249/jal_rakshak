{
  "version": 2,
  "builds": [
    {
      "src": "jal-spotter-dash/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "jal-spotter-dash/dist"
      }
    },
    {
      "src": "api/**/*.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/jal-spotter-dash/$1"
    }
  ],
  "env": {
    "PYTHON_VERSION": "3.12"
  },
  "functions": {
    "api/**/*.py": {
      "maxDuration": 30,
      "memory": 1024
    }
  }
}
